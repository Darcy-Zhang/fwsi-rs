import builtins
import typing
__all__ = [
    "ImageInfo",
    "Reader",
    "Region",
    "Writer",
    "open",
]

@typing.final
class ImageInfo:
    @property
    def width(self) -> builtins.int: ...
    @property
    def height(self) -> builtins.int: ...
    @property
    def tile_size(self) -> builtins.int: ...
    @property
    def tiles_x(self) -> builtins.int: ...
    @property
    def tiles_y(self) -> builtins.int: ...
    @property
    def tile_count(self) -> builtins.int: ...
    @property
    def image_hash(self) -> bytes: ...
    @property
    def image_hash_hex(self) -> builtins.str: ...
    @property
    def content_id(self) -> builtins.str: ...

@typing.final
class Reader:
    @property
    def info(self) -> ImageInfo: ...
    @staticmethod
    def open(path: builtins.str) -> Reader: ...
    def read(self, x: builtins.int, y: builtins.int, width: builtins.int, height: builtins.int) -> Region: ...

@typing.final
class Region:
    @property
    def data(self) -> bytes: ...
    @property
    def width(self) -> builtins.int: ...
    @property
    def height(self) -> builtins.int: ...

@typing.final
class Writer:
    @staticmethod
    def create(path: builtins.str, width: builtins.int, height: builtins.int, tile_size: builtins.int = 1024) -> Writer: ...
    @staticmethod
    def create_from_jpeg_tiles(path: builtins.str, width: builtins.int, height: builtins.int, tile_size: builtins.int, tiles: typing.Sequence[typing.Sequence[bytes]], rgb: bytes) -> ImageInfo: ...
    def write_tile(self, x: builtins.int, y: builtins.int, data: bytes) -> None: ...
    def finish(self) -> ImageInfo: ...

def open(path: builtins.str) -> Reader: ...
